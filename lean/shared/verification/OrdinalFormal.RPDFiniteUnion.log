OrdinalFormal.RPDFiniteUnion.standard_fs_paper {g : RPD.Diagram} (hg : RPD.Standard (RPD.Term.finite g)) {e : Entry Nat}
  (he : Columns.control compare ((List.getLast? g).getD []) = some e) (n : Nat) :
  List.length (RPD.fs g n) = List.length g - 1 + n * (List.length g - 1 - e.parent) ∧
    ∀ (j : Nat) (a : Entry Nat), a ∈ (RPD.fs g n)[j]?.getD [] ↔ PaperEdge g e n j a
OrdinalFormal.RPDFiniteUnion.standard_fs_eq_paper {g : RPD.Diagram} (hg : RPD.Standard (RPD.Term.finite g))
  {e : Entry Nat} (he : PaperController ((List.getLast? g).getD []) e) {n : Nat} {h : RPD.Diagram}
  (hh : PaperResult g e n h) : RPD.fs g n = h
