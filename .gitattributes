# Keep text checkouts consistent across platforms.
* text=auto eol=lf

# The release checker verifies the pinned NER scripts byte for byte.
*.ne-rewritten.js -text

# ReportLab PDFs can be ASCII-only but must never undergo text conversion.
*.pdf binary

# Preserve the rule-version hashes of the Laver lower-bound reference kernels.
laver_table_lower_bounds/code/*.py -text
